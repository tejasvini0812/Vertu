# Copy to .env.local (never commit it) and fill in from Supabase: Project Settings -> API.
# Leave both empty to run on per-browser sample data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key (or the newer "publishable" key). It is meant for browsers: row level security protects the data.
# NEVER put the service_role / secret key in any VITE_ variable: those are bundled into the public site.
VITE_SUPABASE_ANON_KEY=
