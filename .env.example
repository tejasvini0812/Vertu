# Copy to .env.local (never commit it) and fill in from Supabase: Project Settings -> API.
# Leave both empty to run on per-browser sample data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key (or the newer "publishable" key). It is meant for browsers: row level security protects the data.
# NEVER put the service_role / secret key in any VITE_ variable: those are bundled into the public site.
VITE_SUPABASE_ANON_KEY=

# Set to true after enabling the Google provider in Supabase (Authentication -> Sign in / Providers).
VITE_AUTH_GOOGLE=false

# Your live address, used for the sitemap, canonical links and social previews (set it in your host too).
SITE_URL=https://yourdomain.com

# Optional analytics, only after the visitor agrees in Privacy choices. Leave empty for none (no banner then).
#   plausible + your domain (cookie-free, recommended)   or   ga4 + your G-XXXXXXX measurement ID
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_ID=
